# Research pipeline (DuckDB + Binance USD-M TradFi USDT perps). No API keys required.
# Copy to .env and adjust as needed.

DUCKDB_PATH=data/alphagpt.duckdb

# USD-M futures REST. www.binance.com works in regions where fapi.binance.com returns HTTP 451.
BINANCE_BASE_URL=https://www.binance.com
# Canonical stored bars. 5m and 1h are resampled from 1m inside DuckDB.
BINANCE_INTERVAL=1m
BAR_INTERVAL=1h
BINANCE_START=2026-01-01
BINANCE_CONCURRENCY=6
# Stay under USD-M 2400 weight/min (klines limit=1000 is weight 5).
KLINE_MIN_INTERVAL_SEC=0.13

# Universe: TRADIFI_PERPETUAL quoted in USDT, e.g. MUUSDT, LITEUSDT, TSLAUSDT
TRADFI_SEED_SYMBOLS=MUUSDT,LITEUSDT,TSLAUSDT,NVDAUSDT,CRCLUSDT,SNDKUSDT
TRADFI_UNDERLYING_TYPES=EQUITY,KR_EQUITY,HK_EQUITY,CN_EQUITY,PREMARKET
TRADFI_INCLUDE_COMMODITIES=0
MIN_QUOTE_VOLUME_24H=10000
# Optional cap for smoke tests; 0 = all matching TradFi perps
MAX_SYMBOLS=0

# Backtest / training (USD-M taker-style default 5 bps)
FEE_BPS=5
TRADE_SIZE_USD=1000
# 1m default is 100 if unset; hourly default is 1000
MIN_QUOTE_VOLUME=1000
BATCH_SIZE=256
TRAIN_STEPS=200
MAX_FORMULA_LEN=8
STRATEGY_FILE=best_tradfi_strategy.json
# 0 = all symbols. Hold out the last TEST_DAYS from training; also report last OOS_DAYS.
LIMIT_SYMBOLS=0
TEST_DAYS=30
OOS_DAYS=14
# BAR_INTERVAL=1m LIMIT_SYMBOLS=0 TEST_DAYS=30 python -m model_core.engine
