# Research pipeline (DuckDB + Binance bStocks). No API keys required.
# Copy to .env and adjust as needed.

# DuckDB file used by data_pipeline, model_core, and the research dashboard
DUCKDB_PATH=data/alphagpt.duckdb

# Binance public Spot REST. data-api.binance.vision works in regions where
# api.binance.com returns HTTP 451.
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_INTERVAL=1h
BINANCE_START=2026-06-01
BINANCE_CONCURRENCY=8

# Universe filters
MIN_QUOTE_VOLUME_24H=10000
BSTOCK_SEED_SYMBOLS=TSLABUSDT,NVDABUSDT,CRCLBUSDT,SNDKBUSDT,MUBUSDT
# Optional cap for smoke tests; 0 = all matching bStocks
MAX_SYMBOLS=0

# Backtest / training
SPOT_FEE_BPS=10
TRADE_SIZE_USD=1000
MIN_QUOTE_VOLUME=1000
BATCH_SIZE=256
TRAIN_STEPS=200
MAX_FORMULA_LEN=8
STRATEGY_FILE=best_bstock_strategy.json
